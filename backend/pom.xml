<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.sentinelx</groupId>
    <artifactId>sentinelx-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>SentinelX Backend</name>
    <description>Aggregator for all SentinelX microservices (Phase 1: minimal runnable scaffolds)</description>

    <modules>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>payment-service</module>
        <module>retail-service</module>
        <module>security-event-service</module>
        <module>detection-engine</module>
        <module>risk-engine</module>
        <module>alert-service</module>
        <module>simulation-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!--
            Forced Docker Engine API version. This build targets Docker daemons that
            require API >= 1.44 (Docker 28+); docker-java otherwise negotiates an API
            version the daemon rejects. Override via `-Ddocker.api.version=<n>` for
            environments that need an older version.
        -->
        <docker.api.version>1.44</docker.api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- docker-java reads `api.version`; force a value the daemon accepts. -->
                        <argLine>-Dapi.version=${docker.api.version}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>