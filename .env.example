# ---------------------------------------------------------------------------
# SentinelX environment configuration (copy to .env and adjust as needed)
# ---------------------------------------------------------------------------

# Image tags
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=bitnami/kafka:3.7.2
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
GRAFANA_IMAGE=grafana/grafana:11.2.0

# PostgreSQL
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx
POSTGRES_DB=sentinelx
POSTGRES_HOST_PORT=5434

# Redis
REDIS_HOST_PORT=6379

# Kafka (KRaft, no ZooKeeper)
KAFKA_HOST_PORT=9092

# OpenSearch
OPENSEARCH_HOST_PORT=9200

# Observability
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Frontend
FRONTEND_HOST_PORT=8090

# Backend service ports (host bindings)
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
RETAIL_SERVICE_PORT=8083
SECURITY_EVENT_SERVICE_PORT=8084
DETECTION_ENGINE_PORT=8085
RISK_ENGINE_PORT=8086
ALERT_SERVICE_PORT=8087
SIMULATION_SERVICE_PORT=8088

# Env metadata
SENTINELX_ENV=local