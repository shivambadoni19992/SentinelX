{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "SentinelX - System Health",
  "uid": "sentinelx-health",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service Up (up metric)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up targets",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "count(up == 1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Down targets",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "count(up == 0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM heap used (all services)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "max(jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["sentinelx", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "version": 1
}